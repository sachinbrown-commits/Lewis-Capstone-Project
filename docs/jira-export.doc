<table class="tableBorder" cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td bgcolor="#f0f0f0" width="100%" colspan="2" valign="top">
                            <b><a id="parent_issue_summary" href="https://redacademy-team-quallityengineer.atlassian.net/browse/LCP-41">Payment data integrity</a></b>
                <span style="font-size: 9px">(<a id="parent_issue_key" href="https://redacademy-team-quallityengineer.atlassian.net/browse/LCP-41">LCP-41</a>)</span>
                <h3 class="formtitle"><img src="https://redacademy-team-quallityengineer.atlassian.net/images/icons/link_out_bot.gif" width="16" height="16" />
                        [LCP-44]&nbsp;<a href="https://redacademy-team-quallityengineer.atlassian.net/browse/LCP-44">Successful Payment Authorization with Valid Card</a>
            <span class="subText">
               Created: 14/May/26                   &nbsp;Updated: 21/Jun/26

                                                    &nbsp;Resolved: 08/Jun/26
                            </span>
            </h3>
        </td>
    </tr>
    <tr>
        <td width="20%"><b>Status:</b></td>
        <td width="80%">Done</td>
